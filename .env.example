# Supabase Credentials
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Maps API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Email notification endpoint (PHP or serverless function that sends match update emails)
EXPO_PUBLIC_NOTIFICATION_URL=https://your-domain.com/send_match_update.php

# Monei payments — server-side only, never expose to client
# Test key starts with pk_test_, production with pk_live_
MONEI_API_KEY=pk_test_...
# Public base URL of the web app (for Monei return URLs)
APP_BASE_URL=https://your-domain.com/your-path
# Secret for the reconcile-payments Edge Function (random string)
RECONCILE_SECRET=generate-a-random-string-here

# FTP credentials for `npm run deploy` (scripts/deploy*.js)
FTP_HOST=ftp.example.com
FTP_USER=ftp-user
FTP_PASSWORD=ftp-password
